{
  "name": "orchard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx scripts/data-build.ts && vite",
    "build": "tsx scripts/data-build.ts && npm run build:app",
    "build:app": "vite build && vite build --config vite.prerender.config.ts && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "deploy": "tsx scripts/data-build.ts --production && npm run build:app && wrangler deploy",
    "typecheck": "tsx scripts/data-build.ts && tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "postinstall": "npm run cf-typegen",
    "usda:probe": "tsx scripts/usda-probe.ts",
    "usda:terminal-probe": "tsx scripts/usda-terminal-probe.ts",
    "usda:derive": "tsx scripts/usda-derive.ts",
    "usda:terminal-screen": "tsx scripts/usda-terminal-screen.ts",
    "check:changed": "tsx scripts/data-build.ts && tsc -b && biome check . && vitest run --passWithNoTests --changed",
    "data:build": "tsx scripts/data-build.ts",
    "content:report": "tsx scripts/content-report.ts",
    "evidence:fetch": "tsx scripts/evidence-fetch.ts",
    "evidence:check": "tsx scripts/evidence-check.ts",
    "panel:check": "tsx scripts/panel-check.ts",
    "art:process": "tsx scripts/art-process.ts"
  },
  "dependencies": {
    "hono": "4.13.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "1.69.1",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "fast-check": "4.10.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.163.0"
  }
}
