{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Prerendered pages and the SPA fallback are static; only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    // Prerendered pages live at clean URLs (/items/apples, not /items/apples/), matching the app's links and
    // the service worker's precache.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Feedback (M8). The database is created on Jared's account before the first deploy that needs it; its id goes here.
  "d1_databases": [{ "binding": "DB", "database_name": "orchard", "migrations_dir": "migrations" }],
  // Per-visitor limit, keyed by a hash of the IP (src/worker/index.ts); counters are short-lived and never stored.
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Privacy (engineering plan §7): no invocation logs, no Workers Logs, no traces.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } }
}
