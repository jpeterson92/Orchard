{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orchard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Prerendered pages and the SPA fallback are static; only /api/* reaches the Worker first.
    "not_found_handling": "single-page-application",
    // Prerendered pages live at clean URLs (/items/apples, not /items/apples/), matching the app's links and
    // the service worker's precache.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
